     <property name="styleSheet">
      <string notr="true">QLabel {
    /* Font Segoe UI in đậm nhưng kích thước nhỏ gọn */
    font: 700 9pt &quot;Segoe UI&quot;;
    color: #bc1823;           /* Màu đỏ đậm thương hiệu */
    background-color: #ffecee; /* Nền đỏ nhạt để nổi bật chữ */
    
    /* Bo góc và khoảng cách lề */
    border-radius: 5px;
    padding: 3px 8px;
    
    /* Viền mảnh để tạo độ khối */
    border: 1px solid #df9da2;
}</string>
