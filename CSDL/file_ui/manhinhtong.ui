        <property name="styleSheet">
         <string notr="true">QPushButton {
    /* Font Segoe UI, cỡ chữ 10pt, độ đậm 700 (Bold) */
    font: 700 10pt &quot;Segoe UI&quot;; 
    color: white;
    background-color: #bc1823;
    border-radius: 8px; /* Bo góc 8px theo yêu cầu của bạn */
