      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">QPushButton {
    /* Màu nền hồng nhạt phối với viền hồng đậm hơn một chút */
    background-color: #ffecee; 
    border: 1px solid #df9da2;
    border-radius: 6px;
    
    /* Chữ đỏ đậm nhưng cỡ nhỏ lại (9pt thay vì 10-11pt) */
    color: #bc1823;
    font: 700 9pt &quot;Segoe UI&quot;;
    
    /* Không in hoa toàn bộ để trông nhẹ nhàng hơn */
    padding: 5px 15px;
}

QPushButton:hover {
    /* Hiệu ứng khi di chuột vào: Nền đậm hơn xíu */
    background-color: #f8d7da;
    border: 1px solid #bc1823;
}

QPushButton:pressed {
    background-color: #df9da2;
    color: white;
}
</string>
