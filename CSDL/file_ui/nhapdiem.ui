    <property name="styleSheet">
     <string notr="true">QPushButton {
    /* Màu nền và viền */
    background-color: #ffecee; 
    border: 1px solid #df9da2;
    border-radius: 8px; /* Tăng bo góc một chút cho hợp với chữ to */
    
    /* Chữ: In đậm, Cỡ 25pt, Font Segoe UI */
    color: #bc1823;
    font-family: &quot;Segoe UI&quot;;
    font-size: 20pt;
    font-weight: bold;
    
    /* Đệm thêm khoảng trống xung quanh chữ */
    padding: 5px 20px;
}

QPushButton:hover {
    background-color: #f8d7da;
    border: 2px solid #bc1823; /* Viền dày hơn khi di chuột */
}

QPushButton:pressed {
    background-color: #df9da2;
    color: white;
}</string>
