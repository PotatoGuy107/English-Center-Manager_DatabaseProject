     <property name="styleSheet">
      <string notr="true">QLabel {
    /* Màu nền đỏ đậm thương hiệu của Trầm */
    background-color: #bc1823;
    
    /* Chữ trắng, in hoa và đậm (Bold 700) */
    color: white;
    font: 700 10pt &quot;Segoe UI&quot;;
    text-transform: uppercase;
    
    /* Bo góc và viền để khớp với Dashboard */
    border-radius: 8px;
    border: 1px solid #bc1823;
    
    /* Căn giữa chữ tuyệt đối */
    qproperty-alignment: 'AlignCenter';
    padding: 8px;
}

/* Hiệu ứng khi di chuột vào để giao diện sinh động hơn */
QLabel:hover {
    background-color: #ffecee; /* Đổi sang nền hồng nhạt */
    color: #bc1823;           /* Chữ chuyển sang đỏ đậm */
    border: 1px solid #df9da2;
}</string>
