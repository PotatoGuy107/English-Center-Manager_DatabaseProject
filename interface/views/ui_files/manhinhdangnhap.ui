      <property name="styleSheet">
       <string notr="true">QLabel {
    /* Bỏ nền, chỉ để chữ màu đỏ đô thương hiệu */
    background-color: transparent;
    color: #bc1823;
    
    /* Font chữ giữ nguyên độ đậm và in hoa */
    font: 700 10pt &quot;Segoe UI&quot;;
    text-transform: uppercase;
    
    /* Căn giữa chữ */
    qproperty-alignment: 'AlignCenter';
    padding: 5px;
}

/* Hiệu ứng khi di chuột vào (Hover) */
QLabel:hover {
    /* Khi trỏ vào, chữ sẽ sáng hơn một chút hoặc hiện nền hồng rất nhạt để biết là đang trỏ vào */
    background-color: #ffecee; 
    border-radius: 5px;
    color: #9c141d; /* Đỏ đậm hơn một chút khi hover */
}</string>
      </property>
