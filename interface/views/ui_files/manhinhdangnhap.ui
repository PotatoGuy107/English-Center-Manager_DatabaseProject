      <property name="styleSheet">
       <string notr="true">QWidget#widget_login_box {
    background-color: #ffffff; /* Nền trắng tinh */
    border-radius: 15px;       /* Bo góc cho mềm mại */
    border: 1px solid #f0f0f0; /* Viền xám cực nhạt để phân biệt với nền ngoài */
}

/* Các Label tiêu đề bên trong Widget này */
QLabel {
    background-color: transparent; /* Đảm bảo label không có nền đè lên */
    color: #bc1823;               /* Chữ đỏ đô */
    font-family: &quot;Segoe UI Semib/* Dùng dấu chấm ở trước để áp dụng cho chính nó và con của nó */
.QWidget {
    background-color: white;
