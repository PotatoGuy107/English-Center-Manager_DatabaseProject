       </property>
       <property name="styleSheet">
        <string notr="true">QLabel {
    /* Bỏ nền và viền hoàn toàn */
    background-color: transparent;
    border: none;
    
    /* Màu đỏ đô đặc trưng của Trầm */
    color: #bc1823;
    
    /* Phông chữ: Ưu tiên Montserrat nếu máy đã cài, không thì dùng Segoe UI Black */
    font-family: &quot;Montserrat ExtraBold&quot;, &quot;Segoe UI Black&quot;, sans-serif;
    font-size: 26pt;
    font-weight: 900;
    text-transform: uppercase;
    
    /* Giãn cách giữa các chữ cái (quan trọng để làm logo chữ) */
    letter-spacing: 3px;
    
    qproperty-alignment: 'AlignCenter';
}

/* Hiệu ứng lướt qua cực nhẹ để tăng tính tương tác */
QLabel:hover {
    color: #9c141d; /* Đậm hơn một tông khi di chuột vào */
}</string>
       </property>
