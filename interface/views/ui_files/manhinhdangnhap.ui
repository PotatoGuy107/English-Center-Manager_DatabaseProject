       <property name="styleSheet">
        <string notr="true">QLabel {
    /* Màu nền hồng nhạt cố định */
    background-color: #ffecee;
    
    /* Chữ màu đỏ đô thương hiệu */
    color: #bc1823;
    
    /* Font chữ đậm, in hoa chuẩn Dashboard */
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: 700;
    text-transform: uppercase;
    
    /* Bo góc 8px cho mềm mại */
    border-radius: 8px;
    
    /* Viền hồng đậm hơn một chút để định hình khung */
    border: 1px solid #df9da2;
    
    /* Căn giữa chữ và tạo khoảng trống */
    qproperty-alignment: 'AlignCenter';
    padding: 8px;
}</string>
       </property>
       <property name="text">
