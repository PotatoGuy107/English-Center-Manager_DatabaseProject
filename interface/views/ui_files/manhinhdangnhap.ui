       <property name="styleSheet">
        <string notr="true">QLabel {
    /* Bỏ nền và viền hoàn toàn */
    background-color: transparent;
    border: none;
    
    /* Màu đỏ đô đặc trưng */
    color: #bc1823;
    
    /* Phông chữ Times New Roman */
    font-family: &quot;Times New Roman&quot;, serif;
    font-size: 9pt; /* Tăng size một chút vì chữ thường sẽ nhỏ hơn chữ in hoa */
    font-weight: 700; /* Để Bold vừa phải cho rõ nét */
    
    /* KHÔNG viết in hoa */
    text-transform: none;
    
    /* Giãn cách giữa các chữ cái nhẹ nhàng */
    letter-spacing: 1px;
    
    qproperty-alignment: 'AlignCenter';
}

/* Hiệu ứng khi di chuột vào */
QLabel:hover {
    color: #9c141d;
    /* Có thể thêm gạch chân nếu muốn giống style link web */
