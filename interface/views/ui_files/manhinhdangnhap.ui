       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
    /* Màu nền đỏ đậm thương hiệu của Trầm */
    background-color: #bc1823; 
    border: 1px solid #bc1823;
    border-radius: 6px;
    
    /* Chữ chuyển sang màu trắng để nổi trên nền đỏ */
    color: white;
    font: 700 9pt &quot;Segoe UI&quot;;
    
    /* Khoảng cách bên trong nút */
    padding: 5px 15px;
}

QPushButton:hover {
    /* Hiệu ứng khi di chuột vào: Đỏ sậm hơn một chút */
    background-color: #9c141d;
    border: 1px solid #9c141d;
}

QPushButton:pressed {
    /* Hiệu ứng khi nhấn xuống: Màu hồng đậm và chữ tối lại */
    background-color: #df9da2;
    color: #bc1823;
}</string>
