     <property name="styleSheet">
      <string notr="true">QTableWidget {
    /* Viền ngoài bảng */
    border: 3px solid #bc1823;
    border-radius: 15px;
    background-color: white;
    
    /* KẺ DÒNG: Màu của đường lưới giữa các ô */
    gridline-color: #bc1823; 
    
    font: 700 10pt &quot;Segoe UI&quot;;
    outline: none;
}

/* Thanh tiêu đề (STT, Mã lớp...) */
QHeaderView::section {
    background-color: #bc1823; /* Nền đỏ đậm */
    color: white;              /* Chữ trắng */
    border: 1px solid white;   /* Kẻ dọc màu trắng giữa các tiêu đề cho rõ */
    padding: 5px;
    font: 700 10pt &quot;Segoe UI&quot;;
}

/* Màu nền xen kẽ các hàng (giống ảnh image_5cecb1) */
QTableWidget {
    alternate-background-color: #ffecee; /* Màu hồng nhạt */
}

/* Khi nhấn chọn một ô */
QTableWidget::item:selected {
    background-color: #bc1823;
    color: white;
}</string>
